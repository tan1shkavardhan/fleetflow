APP_NAME=FleetFlow API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://fleetflow:fleetflow@localhost:5432/fleetflow
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VEHICLE_GEO_KEY=vehicles:locations
TELEMETRY_STREAM_KEY=telemetry:stream
TELEMETRY_STREAM_MAXLEN=100000
DELAY_THRESHOLD_RATIO=0.4
DELAY_CONSECUTIVE_LIMIT=3
DELAY_RECOVERY_RATIO=0.6
DEFAULT_NEARBY_RADIUS_KM=20
DEMO_BREAKDOWN_VEHICLES=truck_006

PROLONGED_STOP_SECONDS=20
